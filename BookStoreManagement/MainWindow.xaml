<Window x:Class="BookStoreManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Store Management - Admin"
        Height="750"
        Width="1100"
        MinHeight="650"
        MinWidth="1250"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER WITH LOGOUT -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="BOOK STORE MANAGEMENT - ADMIN"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>




            <!-- ADMIN NAVIGATION -->
            <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                <Button Content="Customer Management"
            Width="175"
            Height="36"
            Margin="0,0,10,0"
            Background="#198754"
            Foreground="White"
            FontWeight="SemiBold"
            Click="btnCustomerManagement_Click"/>

                <Button Content="User Management"
            Width="150"
            Height="36"
            Margin="0,0,10,0"
            Background="#6F42C1"
            Foreground="White"
            FontWeight="SemiBold"
            Click="btnUserManagement_Click"/>

                <Button Content="Order Management"
            Width="160"
            Height="36"
            Margin="0,0,10,0"
            Background="#0D6EFD"
            Foreground="White"
            FontWeight="SemiBold"
            Click="btnOrderManagement_Click"/>

                <Button x:Name="btnLogout"
            Content="Logout"
            Width="110"
            Height="36"
            Background="#DC3545"
            Foreground="White"
            FontWeight="SemiBold"
            Click="btnLogout_Click"/>

            </StackPanel>



        </Grid>

        <!-- SEARCH AND FILTER -->
        <GroupBox Grid.Row="1"
                  Header="SEARCH AND FILTER"
                  Padding="12"
                  Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Book Title:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtSearch"
                         Width="230"
                         Margin="10,0,20,0"/>

                <TextBlock Text="Category:"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cbFilterCategory"
                          Width="200"
                          Margin="10,0,20,0"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryId"/>

                <Button Content="Search"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="btnSearch_Click"/>

                <Button Content="Reset"
                        Width="100"
                        Click="btnReset_Click"/>

            </StackPanel>
        </GroupBox>

        <!-- BOOK LIST -->
        <GroupBox Grid.Row="2"
                  Header="BOOK LIST"
                  Padding="10"
                  Margin="0,0,0,15">

            <DataGrid x:Name="dgBooks"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="dgBooks_SelectionChanged"
                      CanUserAddRows="False">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding BookId}"
                                        Width="55"/>

                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Price"
                                        Binding="{Binding Price, StringFormat={}{0:N0}}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Quantity"
                                        Binding="{Binding Quantity}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding CategoryName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Author"
                                        Binding="{Binding AuthorName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Publisher"
                                        Binding="{Binding PublisherName}"
                                        Width="*"/>

                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- BOOK INFORMATION -->
        <GroupBox Grid.Row="3"
                  Header="BOOK INFORMATION"
                  Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ROW 0: TITLE AND PRICE -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Book Title:"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox x:Name="txtTitle"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="5"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Price:"
                           VerticalAlignment="Center"
                           Margin="10,5"/>

                <TextBox x:Name="txtPrice"
                         Grid.Row="0"
                         Grid.Column="3"
                         Margin="5"/>

                <!-- ROW 1: QUANTITY AND CATEGORY -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Quantity:"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox x:Name="txtQuantity"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Category:"
                           VerticalAlignment="Center"
                           Margin="10,5"/>

                <ComboBox x:Name="cbCategory"
                          Grid.Row="1"
                          Grid.Column="3"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryId"
                          Margin="5"/>

                <!-- ROW 2: AUTHOR AND PUBLISHER -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Author:"
                           VerticalAlignment="Center"
                           Margin="0,5"/>

                <TextBox x:Name="txtAuthor"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="5"
                         ToolTip="Enter author name"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Publisher:"
                           VerticalAlignment="Center"
                           Margin="10,5"/>

                <TextBox x:Name="txtPublisher"
                         Grid.Row="2"
                         Grid.Column="3"
                         Margin="5"
                         ToolTip="Enter publisher name"/>

                <!-- ROW 3: CRUD BUTTONS -->
                <StackPanel Grid.Row="3"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0">

                    <Button Content="Add"
                            Width="110"
                            Height="35"
                            Margin="5"
                            Click="btnAdd_Click"/>

                    <Button Content="Update"
                            Width="110"
                            Height="35"
                            Margin="5"
                            Click="btnUpdate_Click"/>

                    <Button Content="Delete"
                            Width="110"
                            Height="35"
                            Margin="5"
                            Click="btnDelete_Click"/>

                    <Button Content="Clear"
                            Width="110"
                            Height="35"
                            Margin="5"
                            Click="btnClear_Click"/>

                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
