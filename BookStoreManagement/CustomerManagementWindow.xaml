<Window x:Class="BookStoreManagement.CustomerManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Store - Customer Management"
        Height="750"
        Width="1100"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CUSTOMER MANAGEMENT"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Manage customer information"
                           Foreground="Gray"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Close"
                    Width="100"
                    Height="35"
                    Click="btnClose_Click"/>
        </Grid>

        <!-- SEARCH -->
        <GroupBox Grid.Row="1"
                  Header="SEARCH CUSTOMERS"
                  Padding="12"
                  Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Keyword:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtSearch"
                         Width="300"
                         Height="30"
                         Margin="10,0,15,0"/>

                <Button Content="Search"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="btnSearch_Click"/>

                <Button Content="Reset"
                        Width="100"
                        Margin="0,0,15,0"
                        Click="btnReset_Click"/>

                <TextBlock x:Name="txtTotalCustomers"
                           Text="Total Customers: 0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- CUSTOMER LIST -->
        <GroupBox Grid.Row="2"
                  Header="CUSTOMER LIST"
                  Padding="10"
                  Margin="0,0,0,15">

            <DataGrid x:Name="dgCustomers"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="dgCustomers_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding CustomerId}"
                                        Width="65"/>

                    <DataGridTextColumn Header="Full Name"
                                        Binding="{Binding FullName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Address"
                                        Binding="{Binding Address}"
                                        Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- EDIT CUSTOMER -->
        <GroupBox Grid.Row="3"
                  Header="EDIT CUSTOMER INFORMATION"
                  Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- FULL NAME -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Full Name *"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtFullName"
                         Grid.Row="0" Grid.Column="1"
                         Height="30"
                         MaxLength="150"
                         Margin="5"/>

                <!-- PHONE -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Phone *"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtPhone"
                         Grid.Row="0" Grid.Column="3"
                         Height="30"
                         MaxLength="20"
                         Margin="5"/>

                <!-- EMAIL -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Email *"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtEmail"
                         Grid.Row="1" Grid.Column="1"
                         Height="30"
                         MaxLength="150"
                         Margin="5"/>

                <!-- ADDRESS -->
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="Address *"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtAddress"
                         Grid.Row="1" Grid.Column="3"
                         Height="30"
                         MaxLength="255"
                         Margin="5"/>

                <!-- NOTICE -->
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="4"
                           Text="(*) All fields are required. Phone must contain 10-20 digits."
                           Foreground="#DC3545"
                           Margin="5,10,0,5"/>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="3"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">

                    <Button Content="Save Changes"
                            Width="140"
                            Height="36"
                            Margin="5"
                            Background="#198754"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="btnSave_Click"/>

                    <Button Content="Clear Selection"
                            Width="140"
                            Height="36"
                            Margin="5"
                            Click="btnClear_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
