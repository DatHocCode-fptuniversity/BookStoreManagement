<Window x:Class="BookStoreManagement.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Store - Customer"
        Height="750"
        Width="1250"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="BOOK STORE - CUSTOMER"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Browse books and manage your cart"
                           Foreground="Gray"
                           Margin="0,5,0,0"/>
            </StackPanel>



            <!-- CUSTOMER NAVIGATION -->
            <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                <Button Content="My Profile"
            Width="110"
            Height="36"
            Margin="0,0,10,0"
            Background="#198754"
            Foreground="White"
            FontWeight="SemiBold"
            Click="btnMyProfile_Click"/>

                <Button Content="My Orders"
            Width="110"
            Height="36"
            Margin="0,0,10,0"
            Background="#0D6EFD"
            Foreground="White"
            FontWeight="SemiBold"
            Click="btnMyOrders_Click"/>

                <Button Content="Logout"
            Width="110"
            Height="36"
            Background="#DC3545"
            Foreground="White"
            FontWeight="SemiBold"
            Click="btnLogout_Click"/>

            </StackPanel>


        </Grid>

        <!-- SEARCH AND FILTER -->
        <GroupBox Grid.Row="1"
                  Header="SEARCH BOOKS"
                  Padding="12"
                  Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Book Title:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtSearch"
                         Width="230"
                         Margin="10,0,20,0"/>

                <TextBlock Text="Category:"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cbCategory"
                          Width="200"
                          Margin="10,0,20,0"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryId"/>

                <Button Content="Search"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="btnSearch_Click"/>

                <Button Content="Reset"
                        Width="100"
                        Click="btnReset_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- BOOKS AND CART -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: AVAILABLE BOOKS -->
            <GroupBox Grid.Column="0"
                      Header="AVAILABLE BOOKS"
                      Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgBooks"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionChanged="dgBooks_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding BookId}"
                                                Width="45"/>

                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price, StringFormat={}{0:N0}}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Stock"
                                                Binding="{Binding Quantity}"
                                                Width="65"/>

                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category.CategoryName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Author"
                                                Binding="{Binding Author.AuthorName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Publisher"
                                                Binding="{Binding Publisher.PublisherName}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ADD TO CART -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">

                        <TextBlock Text="Quantity:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtQuantity"
                                 Text="1"
                                 Width="60"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Center"
                                 Margin="0,0,10,0"/>

                        <Button Content="Add to Cart"
                                Width="120"
                                Height="34"
                                Background="#198754"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="btnAddToCart_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- RIGHT: SHOPPING CART -->
            <GroupBox Grid.Column="2"
                      Header="YOUR CART"
                      Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgCart"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Quantity}"
                                                Width="45"/>

                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Subtotal"
                                                Binding="{Binding Subtotal, StringFormat={}{0:N0}}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- QUANTITY CONTROLS -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">

                        <Button Content="-"
                                Width="45"
                                Height="32"
                                Margin="3"
                                Click="btnDecrease_Click"/>

                        <Button Content="+"
                                Width="45"
                                Height="32"
                                Margin="3"
                                Click="btnIncrease_Click"/>

                        <Button Content="Remove"
                                Width="90"
                                Height="32"
                                Margin="3"
                                Click="btnRemove_Click"/>
                    </StackPanel>

                    <!-- TOTAL -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,10">

                        <TextBlock Text="Total: "
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="txtTotal"
                                   Text="0 VND"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#198754"/>
                    </StackPanel>

                    <!-- CHECKOUT BUTTON -->
                    <Button x:Name="btnCheckout"
                            Grid.Row="3"
                            Content="Checkout"
                            Height="40"
                            Background="#198754"
                            Foreground="White"
                            FontWeight="SemiBold"
                            IsEnabled="False"
                            Click="btnCheckout_Click"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
