<Window x:Class="BookStoreManagement.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookStore - Login"
        Height="450"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="BOOK STORE"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Sign in to your account"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- USERNAME -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="Username"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="txtUsername"
                     Height="36"
                     Padding="8"
                     FontSize="14"/>
        </StackPanel>

        <!-- PASSWORD -->
        <StackPanel Grid.Row="2" Margin="0,0,0,25">
            <TextBlock Text="Password"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="txtPassword"
                         Height="36"
                         Padding="8"
                         FontSize="14"/>
        </StackPanel>

        <!-- LOGIN BUTTON -->
        <Button Grid.Row="3"
                Content="LOGIN"
                Height="42"
                FontSize="15"
                FontWeight="Bold"
                Background="#0D6EFD"
                Foreground="White"
                IsDefault="True"
                Click="btnLogin_Click"/>

        <!-- REGISTER BUTTON -->
        <Button Grid.Row="4"
                Content="CREATE NEW ACCOUNT"
                Height="42"
                Margin="0,12,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                Background="#198754"
                Foreground="White"
                Click="btnOpenRegister_Click"/>

    </Grid>
</Window>
