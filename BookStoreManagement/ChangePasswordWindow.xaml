<Window x:Class="BookStoreManagement.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Store - Change Password"
        Height="470"
        Width="480"
        MinHeight="430"
        MinWidth="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="CHANGE PASSWORD"
                       FontSize="25"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Update your account security"
                       FontSize="13"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <!-- CURRENT PASSWORD -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,16">

            <TextBlock Text="Current Password *"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="pbCurrentPassword"
                         Height="36"
                         Padding="8"
                         MaxLength="128"/>
        </StackPanel>

        <!-- NEW PASSWORD -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,16">

            <TextBlock Text="New Password *"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="pbNewPassword"
                         Height="36"
                         Padding="8"
                         MaxLength="128"/>
        </StackPanel>

        <!-- CONFIRM NEW PASSWORD -->
        <StackPanel Grid.Row="3"
                    Margin="0,0,0,15">

            <TextBlock Text="Confirm New Password *"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="pbConfirmPassword"
                         Height="36"
                         Padding="8"
                         MaxLength="128"/>
        </StackPanel>

        <!-- PASSWORD RULE -->
        <TextBlock Grid.Row="4"
                   Text="(*) Required. New password must contain 8-128 characters."
                   FontSize="12"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <!-- BUTTONS -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnUpdatePassword"
                    Content="UPDATE PASSWORD"
                    Height="40"
                    Background="#198754"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="btnUpdatePassword_Click"/>

            <Button Grid.Column="2"
                    Content="CANCEL"
                    Height="40"
                    Click="btnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
