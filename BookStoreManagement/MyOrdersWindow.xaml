<Window x:Class="BookStoreManagement.MyOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Store - My Orders"
        Height="650"
        Width="1000"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="MY ORDERS"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Your purchase history"
                           Foreground="Gray"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Close"
                    Width="100"
                    Height="35"
                    Click="btnClose_Click"/>
        </Grid>

        <!-- INVOICE LIST -->
        <GroupBox Grid.Row="1"
                  Header="ORDER HISTORY"
                  Padding="10"
                  Margin="0,0,0,15">

            <DataGrid x:Name="dgOrders"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="dgOrders_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice ID"
                                        Binding="{Binding InvoiceId}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Order Date"
                                        Binding="{Binding InvoiceDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Total Amount (VND)"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- INVOICE DETAILS -->
        <GroupBox Grid.Row="2"
                  Header="ORDER DETAILS"
                  Padding="10">

            <DataGrid x:Name="dgOrderDetails"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Book"
                                        Binding="{Binding BookTitle}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Quantity"
                                        Binding="{Binding Quantity}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Unit Price"
                                        Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Subtotal"
                                        Binding="{Binding Subtotal, StringFormat={}{0:N0}}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- TOTAL -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <TextBlock Text="Order Total: "
                       FontSize="18"
                       FontWeight="Bold"/>

            <TextBlock x:Name="txtOrderTotal"
                       Text="0 VND"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#198754"/>
        </StackPanel>
    </Grid>
</Window>
