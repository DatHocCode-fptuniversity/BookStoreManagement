<Window x:Class="BookStoreManagement.AdminOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Book Store - Order Management"
        Height="750"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="ORDER MANAGEMENT"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Close"
                    Width="100"
                    Height="35"
                    Click="btnClose_Click"/>
        </Grid>

        <!-- STATISTICS -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="TOTAL ORDERS"
                      Padding="12">
                <TextBlock x:Name="txtTotalOrders"
                           Text="0"
                           FontSize="24"
                           FontWeight="Bold"/>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="TOTAL REVENUE"
                      Padding="12">
                <TextBlock x:Name="txtTotalRevenue"
                           Text="0 VND"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#198754"/>
            </GroupBox>
        </Grid>

        <!-- SEARCH AND FILTER -->
        <GroupBox Grid.Row="2"
                  Header="SEARCH AND FILTER"
                  Padding="10"
                  Margin="0,0,0,15">

            <WrapPanel>
                <TextBlock Text="Customer / Invoice ID:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="txtSearch"
                         Width="190"
                         Height="28"
                         Margin="0,0,15,0"/>

                <TextBlock Text="From:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker x:Name="dpFrom"
                            Width="135"
                            Margin="0,0,15,0"/>

                <TextBlock Text="To:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker x:Name="dpTo"
                            Width="135"
                            Margin="0,0,15,0"/>

                <Button Content="Search"
                        Width="90"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="btnSearch_Click"/>

                <Button Content="Reset"
                        Width="90"
                        Height="30"
                        Click="btnReset_Click"/>
            </WrapPanel>
        </GroupBox>

        <!-- INVOICE LIST -->
        <GroupBox Grid.Row="3"
                  Header="ALL INVOICES"
                  Padding="10"
                  Margin="0,0,0,15">

            <DataGrid x:Name="dgOrders"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="dgOrders_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice ID"
                                        Binding="{Binding InvoiceId}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding CustomerName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding InvoiceDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Total (VND)"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- INVOICE DETAILS -->
        <GroupBox Grid.Row="4"
                  Header="INVOICE DETAILS"
                  Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgDetails"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Book"
                                            Binding="{Binding BookTitle}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Quantity}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Unit Price"
                                            Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Subtotal"
                                            Binding="{Binding Subtotal, StringFormat={}{0:N0}}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtSelectedTotal"
                           Grid.Row="1"
                           Text="Selected Invoice: 0 VND"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Margin="0,12,0,0"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
